rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones auxiliares ----------

    function estaAutenticado() {
      return request.auth != null;
    }

    // Busca el rol real del usuario en su documento de Firestore.
    // Nunca confiamos en lo que diga el cliente sobre su propio rol.
    function rolDe(uid) {
      return exists(/databases/$(database)/documents/usuarios/$(uid))
        ? get(/databases/$(database)/documents/usuarios/$(uid)).data.rol
        : null;
    }

    function esEncargada() {
      return estaAutenticado() && rolDe(request.auth.uid) == 'encargada';
    }

    function esAlumno() {
      return estaAutenticado() && rolDe(request.auth.uid) == 'alumno_servicio';
    }

    function esPersonal() {
      return estaAutenticado() && rolDe(request.auth.uid) == 'personal_plantel';
    }

    function esDueno(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    // Catálogo de tipos de actividad (Fase 7). Debe coincidir con
    // TODOS_LOS_TIPOS en js/tipos-actividad.js. Nunca confiamos en que
    // el cliente mande un tipo válido: lo revisamos aquí también.
    function esTipoValido(tipo) {
      return tipo in [
        'Reparar máquina', 'Revisar equipo', 'Resetear equipo',
        'Instalar impresora', 'Instalar Office', 'Instalar programas', 'Configurar software',
        'Problemas de software', 'Apoyo con correos institucionales', 'Configuración de equipos',
        'Apoyo con NSS', 'Línea de pago', 'Otros trámites del alumno',
        'Seguimiento de cursos', 'Apoyo en actividades',
        'Publicidad para redes sociales', 'Material para redes del plantel',
        'Actividad personalizada'
      ];
    }

    // ---------- usuarios/{userId} ----------
    match /usuarios/{userId} {

      allow read: if esDueno(userId) || esEncargada();

      allow create:
        // Registro público de un alumno de servicio (register.js):
        // solo puede crear SU PROPIO documento y con rol alumno_servicio.
        if (esDueno(userId) && request.resource.data.rol == 'alumno_servicio')
        // Alta de personal hecha por la encargada (dashboard-encargada.js):
        // quien escribe ya debe ser encargada, y el nuevo doc debe ser personal_plantel.
        || (esEncargada() && request.resource.data.rol == 'personal_plantel');

      allow update:
        // El propio usuario puede editar su perfil, pero jamás su rol.
        if (esDueno(userId) && request.resource.data.rol == resource.data.rol)
        // La encargada puede editar (p.ej. activar/desactivar) SOLO cuentas
        // de personal_plantel, y sin poder convertirlas en otro rol.
        || (esEncargada()
            && resource.data.rol == 'personal_plantel'
            && request.resource.data.rol == 'personal_plantel');

      allow delete: if false; // no implementado todavía
    }

    // ---------- disponibilidad/{alumnoId} ----------
    match /disponibilidad/{alumnoId} {

      allow read: if esDueno(alumnoId) || esEncargada();

      allow create, update:
        if esDueno(alumnoId)
        && esAlumno()
        && request.resource.data.alumnoId == alumnoId;

      allow delete: if false; // no implementado todavía
    }

    // ---------- equipos/{equipoId} ----------
    match /equipos/{equipoId} {

      // Encargada y personal del plantel pueden ver los equipos
      // (el personal los necesita para "Mis equipos" en la Fase 5).
      // El alumno también, si una de sus actividades asignadas trae equipo.
      allow read: if esEncargada() || esPersonal() || esAlumno();

      // Solo la encargada puede dar de alta o editar equipos.
      allow create, update: if esEncargada();

      allow delete: if false; // no implementado todavía
    }

    // ---------- solicitudes/{solicitudId} ----------
    match /solicitudes/{solicitudId} {

      // El personal ve sus propias solicitudes; la encargada las ve todas;
      // el alumno solo ve aquellas donde está en alumnosAsignadosUids.
      allow read: if esEncargada()
        || (esPersonal() && resource.data.creadoPorUid == request.auth.uid)
        || (esAlumno() && request.auth.uid in resource.data.alumnosAsignadosUids);

      // El personal crea solicitudes (nacen "pendiente") a su propio
      // nombre. La encargada también puede crear actividades directamente
      // (nacen "aprobada", ya que no necesita aprobarse a sí misma). En
      // ambos casos el tipo debe venir del catálogo, no de cualquier texto.
      allow create:
        if esTipoValido(request.resource.data.tipo)
        && request.resource.data.creadoPorUid == request.auth.uid
        && (
          (esPersonal() && request.resource.data.estado == 'pendiente')
          || (esEncargada() && request.resource.data.estado in ['pendiente', 'aprobada'])
        );

      // El personal puede actualizar SU solicitud solo para adjuntar la
      // evidencia (evidenciaURL/evidenciaPath) tras crear el documento,
      // sin tocar el estado ni cambiar de dueño.
      //
      // La encargada solo puede mover el estado por la transición que le
      // corresponde, y nunca "saltarse" pasos:
      //   pendiente   -> aprobada  (revisó y aceptó la solicitud)
      //   pendiente   -> rechazada (revisó y la rechazó)
      //   aprobada    -> asignada  (asignó alumnos; exige al menos uno)
      //   completada  -> verificada (revisó el trabajo terminado y lo cierra)
      //
      // El alumno asignado solo puede avanzar SU actividad un paso a la
      // vez (asignada -> aceptada -> en_proceso -> completada), sin
      // reasignarse, sin cambiar de tipo y sin tocar a los demás alumnos.
      allow update:
        if (esPersonal()
            && resource.data.creadoPorUid == request.auth.uid
            && request.resource.data.creadoPorUid == resource.data.creadoPorUid
            && request.resource.data.estado == resource.data.estado)
        || (esEncargada()
            && request.resource.data.creadoPorUid == resource.data.creadoPorUid
            && (
              (resource.data.estado == 'pendiente' && request.resource.data.estado in ['aprobada', 'rechazada'])
              || (resource.data.estado == 'aprobada'
                  && request.resource.data.estado == 'asignada'
                  && request.resource.data.alumnosAsignadosUids.size() > 0)
              || (resource.data.estado == 'completada' && request.resource.data.estado == 'verificada')
            ))
        || (esAlumno()
            && request.auth.uid in resource.data.alumnosAsignadosUids
            && request.resource.data.creadoPorUid == resource.data.creadoPorUid
            && request.resource.data.alumnosAsignadosUids == resource.data.alumnosAsignadosUids
            && request.resource.data.tipo == resource.data.tipo
            && (
              (resource.data.estado == 'asignada' && request.resource.data.estado == 'aceptada')
              || (resource.data.estado == 'aceptada' && request.resource.data.estado == 'en_proceso')
              || (resource.data.estado == 'en_proceso' && request.resource.data.estado == 'completada')
            ));

      allow delete: if false; // no implementado todavía
    }

    // ---------- notificaciones/{notifId} ----------
    match /notificaciones/{notifId} {

      // Cada quien ve solo lo suyo: lo dirigido a su uid, o -si es
      // encargada- lo dirigido a ese rol (aviso compartido).
      allow read: if estaAutenticado()
        && (resource.data.paraUid == request.auth.uid
            || (resource.data.paraRol == 'encargada' && esEncargada()));

      // Solo se crean notificaciones para los 3 casos de esta fase, y
      // cada una solo la puede disparar el rol al que le corresponde:
      //   nueva_solicitud        -> la crea el personal, para la encargada.
      //   actividad_asignada     -> la crea la encargada, para un alumno.
      //   actividad_completada   -> la crea el alumno, para la encargada.
      allow create:
        if request.resource.data.creadaPorUid == request.auth.uid
        && request.resource.data.leida == false
        && (
          (request.resource.data.tipo == 'nueva_solicitud'
            && esPersonal() && request.resource.data.paraRol == 'encargada')
          || (request.resource.data.tipo == 'actividad_asignada'
            && esEncargada() && request.resource.data.paraUid is string)
          || (request.resource.data.tipo == 'actividad_completada'
            && esAlumno() && request.resource.data.paraRol == 'encargada')
        );

      // El único cambio permitido es marcarla como leída, y solo quien
      // puede leerla puede marcarla.
      allow update:
        if (resource.data.paraUid == request.auth.uid
            || (resource.data.paraRol == 'encargada' && esEncargada()))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);

      allow delete: if false; // no implementado todavía
    }

    // ---------- Todo lo demás: bloqueado por ahora ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
